<ConverterLayout>:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: 'Конвертер валют'
        font_size: '28sp'
        size_hint_y: None
        height: dp(50)
        color: 0, 0.5, 0.7, 1

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(220)
        padding: dp(10)
        spacing: dp(10)

        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(15)]

        Label:
            text: 'Введите сумму:'
            color: 0, 0, 0, 1
            size_hint_y: None
            height: dp(30)
            halign: 'left'
            text_size: self.width, None

        TextInput:
            id: input_amount
            hint_text: 'Например: 100'
            input_filter: 'float'
            multiline: False
            size_hint_y: None
            height: dp(48)
            font_size: '18sp'
            padding: [dp(10), dp(10), dp(10), 0]

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(90)
            spacing: dp(10)

            BoxLayout:
                orientation: 'vertical'

                Label:
                    text: 'Из'
                    color: 0, 0, 0, 1

                Spinner:
                    id: from_spinner
                    text: 'RUB'
                    values: ['RUB', 'USD', 'EUR']
                    size_hint_y: None
                    height: dp(48)

            BoxLayout:
                orientation: 'vertical'

                Label:
                    text: 'В'
                    color: 0, 0, 0, 1

                Spinner:
                    id: to_spinner
                    text: 'USD'
                    values: ['RUB', 'USD', 'EUR']
                    size_hint_y: None
                    height: dp(48)

        Button:
            text: 'Конвертировать'
            size_hint_y: None
            height: dp(56)
            font_size: '18sp'
            background_color: 0, 0.7, 0.3, 1
            on_press: root.convert()

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(150)
        padding: dp(10)
        spacing: dp(5)

        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(15)]

        Label:
            text: 'Результат:'
            color: 0, 0, 0, 1
            size_hint_y: None
            height: dp(30)
            halign: 'left'
            text_size: self.width, None

        Label:
            text: root.result
            font_size: '32sp'
            color: 0, 0.5, 0.7, 1
